<?xml version="1.0" encoding="utf-8"?>
<!-- SOLO para compilaciones de depuración (sustituye al de src/main en debug).
     Permite HTTP sin cifrar hacia el servicio local de lectura de labios del PC
     (kLipreadingLocalUrl en api_service.dart). La versión de producción
     (src/main/res/xml) sigue permitiendo solo localhost. -->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.0.112</domain>
    </domain-config>
</network-security-config>
